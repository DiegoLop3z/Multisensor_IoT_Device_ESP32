#ifndef SECRETS_H
#define SECRETS_H

// Copia este archivo como 'secrets.h' y ajusta los valores si lo deseas.
// 'secrets.h' NUNCA se sube al repositorio (esta en .gitignore).

// 1. Configuracion del Hotspot Wi-Fi creado por la propia ESP32 (SoftAP)
// Al encender la ESP32, conectate a esta red desde tu laptop o celular y
// abre http://192.168.4.1 en el navegador.
#define AP_SSID "ESP32-Multisensor"
#define AP_PASSWORD "iot_practica2"  // Minimo 8 caracteres para WPA2

// 2. (Opcional) Conexion simultanea a un router Wi-Fi existente (WIFI_AP_STA)
// Deja WIFI_STA_ENABLED en 0 para usar unicamente el Hotspot de la ESP32.
#define WIFI_STA_ENABLED 0
#define WIFI_SSID "nombre_de_tu_red"
#define WIFI_PASSWORD "contrasena_de_tu_red"

#endif

